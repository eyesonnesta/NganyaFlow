# All relative paths are resolved from server/, independently of the launch directory.
NGANYAFLOW_DATABASE=data/raw/observations.sqlite3
NGANYAFLOW_CATALOG=data/reference/catalog.json
# Required for write requests. Set a local secret; do not commit .env.
NGANYAFLOW_WRITE_TOKEN=
# Load only a locally trained, trusted joblib artifact.
NGANYAFLOW_MODEL_PATH=
NGANYAFLOW_MAX_EVIDENCE_AGE_MINUTES=30
NGANYAFLOW_MAX_MODEL_AGE_DAYS=30
NGANYAFLOW_MIN_RECENT_ARRIVALS=3
